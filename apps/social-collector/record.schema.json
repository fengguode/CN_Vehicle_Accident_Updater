{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADAS Social Incident Lead",
  "type": "object",
  "required": ["title", "url", "platform"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "title_en": { "type": "string" },
    "content": { "type": "string" },
    "content_en": { "type": "string" },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "platform": { "type": "string", "enum": ["weibo", "xiaohongshu", "douyin", "other_social"] },
    "source_name": { "type": "string" },
    "author": { "type": "string" },
    "external_id": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "event_date": { "type": "string", "format": "date" },
    "brand": { "type": "string" },
    "model": { "type": "string" },
    "province": { "type": "string" },
    "city": { "type": "string" },
    "road_type": { "type": "string" },
    "adas_mode": { "type": "string" },
    "verification_status": { "type": "string", "default": "unverified" },
    "reviewed_relevance": { "type": "boolean" },
    "review_notes": { "type": "string" }
  },
  "additionalProperties": true
}
