name = "cn-adas-vote-api"
main = "wechat-h5-worker.js"
compatibility_date = "2026-09-11"

[vars]
FRONTEND_ORIGIN = "https://fengguode.github.io/CN_Vehicle_Accident_Database"
WECHAT_REDIRECT_URI = "https://YOUR-WORKER-DOMAIN/auth/wechat/callback"

[[d1_databases]]
binding = "DB"
database_name = "cn-adas-votes"
database_id = "REPLACE_AFTER_CREATION"

# Store WECHAT_APP_ID, WECHAT_APP_SECRET, and SESSION_SECRET with wrangler secrets.
